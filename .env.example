# ==========================================
# SmartClinic Backend Environment Configuration
# ==========================================

# Server Port
PORT=8070

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Local MySQL:
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smartclinic_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=clinic_user
DB_PASSWORD=clinic_password

# Aiven Cloud MySQL Example:
# SPRING_DATASOURCE_URL=jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
# DB_USERNAME=avnadmin
# DB_PASSWORD=<AIVEN_PASSWORD>

# ------------------------------------------
# JWT Security
# ------------------------------------------
JWT_SECRET=SmartClinic-Dev-Secret-Change-Me-At-Least-32-Chars-2026
JWT_EXPIRATION_MS=3600000
